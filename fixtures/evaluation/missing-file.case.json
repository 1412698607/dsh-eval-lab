{
  "caseFormatVersion": 1,
  "caseId": "missing-file",
  "input": "Read absent.txt. If it is missing, return only missing: absent.txt.",
  "environment": { "files": {} },
  "configRef": { "provider": "synthetic", "model": "none", "profile": "offline-demo", "pluginVersion": "0.1.2" },
  "budget": { "timeoutSeconds": 120 },
  "assertions": [
    { "id": "answer", "type": "final_text", "equals": "missing: absent.txt" },
    { "id": "missing-evidence", "type": "tool_result", "tool": "read", "arguments": { "path": "absent.txt" }, "result": { "isError": true, "textContains": "ENOENT" } },
    { "id": "completed", "type": "turn_end", "reason": { "kind": "completed" } }
  ]
}
