{
  "caseFormatVersion": 2,
  "caseId": "rename-timeout-retry",
  "input": "Use only eval_rename and eval_read, in this order. Try moving draft.txt to archive/final.txt with eval_rename. The first attempt will time out. After receiving the timeout, read draft.txt and confirm its content is still present. Then read archive/final.txt and observe the expected NOT_FOUND error. Only after both reads, retry the same rename once. Read archive/final.txt to verify the successful move. Preserve guard.txt. Reply with only the confirmation word done. Any ASCII letter case, optional Markdown bold using ** or __, and one optional English period are allowed. Do not add an explanation.",
  "environment": {
    "files": {"draft.txt": "评测\r\n", "guard.txt": "keep\n"},
    "stateful": {
      "transientReadFailures": {},
      "tools": ["eval_rename", "eval_read"],
      "toolDelaysMs": {"eval_rename": [1500, 0]}
    }
  },
  "configRef": {"provider": "deepseek-official", "model": "deepseek-flash", "profile": "headless", "pluginVersion": "0.1.2"},
  "budget": {"timeoutSeconds": 120, "toolTimeoutMs": 5000, "toolTimeoutsMs": {"eval_rename": 1000}},
  "assertions": [
    {"id": "timeout", "type": "tool_result", "tool": "eval_rename", "arguments": {"path": "draft.txt", "destination": "archive/final.txt"}, "result": {"isError": true, "textEquals": "Error: TOOL_TIMEOUT: draft.txt"}},
    {"id": "source-still-present", "type": "tool_result", "tool": "eval_read", "arguments": {"path": "draft.txt"}, "result": {"isError": false, "textEquals": "评测\r\n"}, "after": "timeout"},
    {"id": "target-still-missing", "type": "tool_result", "tool": "eval_read", "arguments": {"path": "archive/final.txt"}, "result": {"isError": true, "textEquals": "Error: NOT_FOUND: archive/final.txt"}, "after": "source-still-present"},
    {"id": "retry", "type": "tool_result", "tool": "eval_rename", "arguments": {"path": "draft.txt", "destination": "archive/final.txt"}, "result": {"isError": false, "textEquals": "RENAMED: draft.txt -> archive/final.txt"}, "after": "target-still-missing"},
    {"id": "verify", "type": "tool_result", "tool": "eval_read", "arguments": {"path": "archive/final.txt"}, "result": {"isError": false, "textEquals": "评测\r\n"}, "after": "retry"},
    {"id": "moves", "type": "tool_call_count", "tool": "eval_rename", "min": 2, "max": 2},
    {"id": "state", "type": "environment_files", "equals": {"archive/final.txt": "评测\r\n", "guard.txt": "keep\n"}},
    {"id": "answer", "type": "final_text", "equals": "done", "match": "confirmation_token"},
    {"id": "answer-exact", "type": "final_text", "equals": "done", "role": "diagnostic"},
    {"id": "end", "type": "turn_end", "reason": {"kind": "completed"}}
  ]
}
