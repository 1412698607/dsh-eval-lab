{
  "caseFormatVersion": 2,
  "caseId": "core-current-over-archive",
  "input": "Use only eval_read and eval_list to inspect virtual fixture files. Use relative POSIX paths exactly. Read README.md to identify the authoritative project file. Read that file and return only its projectName value. Archived files may contain an outdated value. Do not use native file tools, shell commands, or delegation.",
  "environment": {
    "files": {
      "README.md": "Authoritative file: releases/current.md. archive/project.md is obsolete.\n",
      "releases/current.md": "projectName: core-current\n",
      "archive/project.md": "projectName: core-obsolete\n"
    },
    "stateful": {
      "transientReadFailures": {}
    }
  },
  "configRef": {
    "provider": "deepseek-official",
    "model": "deepseek-flash",
    "profile": "headless",
    "pluginVersion": "0.1.2"
  },
  "budget": {
    "timeoutSeconds": 120
  },
  "assertions": [
    {
      "type": "tool_result",
      "tool": "eval_read",
      "arguments": {
        "path": "README.md"
      },
      "result": {
        "isError": false,
        "textContains": "releases/current.md"
      },
      "id": "tool-1"
    },
    {
      "type": "tool_result",
      "tool": "eval_read",
      "arguments": {
        "path": "releases/current.md"
      },
      "result": {
        "isError": false,
        "textContains": "core-current"
      },
      "id": "tool-2"
    },
    {
      "id": "answer",
      "type": "final_text",
      "equals": "core-current"
    },
    {
      "id": "completed",
      "type": "turn_end",
      "reason": {
        "kind": "completed"
      }
    }
  ]
}
