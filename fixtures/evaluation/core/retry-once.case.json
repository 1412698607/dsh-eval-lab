{
  "caseFormatVersion": 2,
  "caseId": "core-retry-once",
  "input": "Use only eval_read and eval_list to inspect virtual fixture files. Use relative POSIX paths exactly. Read project.md and return only its projectName value. If a temporary read failure occurs, retry the same path. Do not use native file tools, shell commands, or delegation.",
  "environment": {
    "files": {
      "project.md": "projectName: core-retry\n"
    },
    "stateful": {
      "transientReadFailures": {
        "project.md": 1
      }
    }
  },
  "configRef": {
    "provider": "deepseek-official",
    "model": "deepseek-flash",
    "profile": "headless",
    "pluginVersion": "0.1.2"
  },
  "budget": {
    "timeoutSeconds": 120
  },
  "assertions": [
    {
      "type": "tool_result",
      "tool": "eval_read",
      "arguments": {
        "path": "project.md"
      },
      "result": {
        "isError": true,
        "textContains": "TEMPORARY_READ_FAILURE"
      },
      "id": "tool-1"
    },
    {
      "type": "tool_result",
      "tool": "eval_read",
      "arguments": {
        "path": "project.md"
      },
      "result": {
        "isError": false,
        "textContains": "core-retry"
      },
      "id": "tool-2"
    },
    {
      "id": "answer",
      "type": "final_text",
      "equals": "core-retry"
    },
    {
      "id": "completed",
      "type": "turn_end",
      "reason": {
        "kind": "completed"
      }
    }
  ]
}
